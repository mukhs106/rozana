{
  "name": "GroceryItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "to_buy",
        "have",
        "dismissed"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray"
      ]
    },
    "note": {
      "type": "string"
    },
    "use_soon": {
      "type": "boolean"
    },
    "leftover": {
      "type": "boolean"
    },
    "use_by": {
      "type": "string"
    },
    "recipe_id": {
      "type": "string"
    },
    "recipe_title": {
      "type": "string"
    },
    "for_diners": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}